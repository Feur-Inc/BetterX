{
  "name": "betterx",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/plugins",
    "packages/extension",
    "packages/desktop",
    "packages/cloud-sync"
  ],
  "scripts": {
    "build": "bun run build:core && bun run build:plugins && bun run build:extension && bun run build:desktop && bun run build:cloud-sync",
    "build:core": "bun run --cwd packages/core build",
    "build:plugins": "bun run --cwd packages/plugins build",
    "build:extension": "bun run --cwd packages/extension build",
    "build:desktop": "bun run --cwd packages/desktop build",
    "build:cloud-sync": "bun run --cwd packages/cloud-sync typecheck",
    "start:cloud-sync": "bun run --cwd packages/cloud-sync start",
    "dev:cloud-sync": "bun run --cwd packages/cloud-sync dev",
    "start:desktop": "bun run --cwd packages/desktop start",
    "dev:extension": "bun run --cwd packages/extension dev",
    "dev:desktop": "bun run --cwd packages/desktop dev:all",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --build packages/core/tsconfig.json packages/plugins/tsconfig.json packages/extension/tsconfig.json packages/desktop/tsconfig.json packages/cloud-sync/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "gemoji": "^8.1.0"
  }
}
