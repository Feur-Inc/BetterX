{
  "name": "@betterx/desktop",
  "productName": "BetterX V3 Desktop",
  "version": "3.0.0",
  "private": true,
  "main": "dist/main/index.mjs",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run build:main && bun run build:preload && bun run build:editor && bun run build:emoji && bun run build:bundle",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:editor": "vite build --config vite.editor.config.ts",
    "build:emoji": "vite build --config vite.emoji.config.ts",
    "start": "ELECTRON_OZONE_PLATFORM_HINT=auto electron dist/main/index.mjs",
    "dev": "bun run build:main && bun run build:preload && concurrently \"bun run build:main --watch\" \"bun run build:preload --watch\" \"ELECTRON_OZONE_PLATFORM_HINT=auto electron dist/main/index.mjs\"",
    "dev:bundle": "vite build --config vite.bundle.config.ts --watch",
    "dev:all": "bun run build:main && bun run build:preload && bun run build:bundle && concurrently \"bun run build:main --watch\" \"bun run build:preload --watch\" \"bun run dev:bundle\" \"ELECTRON_OZONE_PLATFORM_HINT=auto BETTERX_DEV=1 electron --remote-debugging-port=9229 dist/main/index.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@betterx/core": "*",
    "@betterx/plugins": "*",
    "@xhayper/discord-rpc": "^1.3.0",
    "codemirror": "^6.0.2",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "concurrently": "^9.1.2",
    "electron": "^42.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  },
  "build": {
    "appId": "com.feurinc.betterx",
    "productName": "BetterX V3 Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/bundle/*.iife.js",
      "assets/**/*",
      "!**/*.map"
    ],
    "protocols": {
      "name": "BetterX",
      "schemes": ["betterx"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "mimeTypes": ["x-scheme-handler/betterx"]
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
