{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@betterx/core": ["../core/src/index.ts"],
      "@betterx/plugins": ["../plugins/src/index.ts"]
    }
  },
  "references": [{ "path": "../core" }, { "path": "../plugins" }],
  "include": ["src/**/*"]
}
