{
  "manifest_version": 3,
  "name": "BetterX V3",
  "version": "3.0.0",
  "description": "Enhance your X (Twitter) experience",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "clipboardWrite", "clipboardRead"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/main-world.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/early-logo.ts"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "BetterX V3"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "betterx@feur.inc",
      "strict_min_version": "128.0"
    }
  }
}
